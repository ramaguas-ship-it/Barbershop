<%- include('../partials/header', { titulo: 'Editar servicio' }) %>
<section class="card narrow">
  <h1>Editar servicio</h1>
  <%- include('../partials/errores', { errores }) %>
  <form method="post" action="/admin/servicios/<%= s.id %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Nombre <input name="nombre" required minlength="3" maxlength="80" value="<%= s.nombre %>"></label>
    <label>Duración (min) <input type="number" name="duracion_min" required min="5" max="480" step="5" value="<%= s.duracion_min %>"></label>
    <label>Precio (USD) <input type="number" name="precio" required min="0" max="9999.99" step="0.01" value="<%= s.precio %>"></label>
    <button>Guardar</button> <a href="/admin/servicios">Cancelar</a>
  </form>
</section>
<%- include('../partials/footer') %>
