<%- include('../partials/header', { titulo: 'Iniciar sesión' }) %>
<section class="card narrow">
  <h1>Iniciar sesión</h1>
  <% if (error) { %><div class="flash error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/login">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Correo <input type="email" name="correo" required autocomplete="username"></label>
    <label>Contraseña <input type="password" name="password" required autocomplete="current-password"></label>
    <button>Ingresar</button>
  </form>
  <p>¿Cliente nuevo? <a href="/registro">Regístrese aquí</a>.</p>
</section>
<%- include('../partials/footer') %>
