# Copie este archivo como .env y ajuste los valores.
PORT=3000
# Contenedor Docker del equipo: usuario admin_abd, puerto 5432, base barbershop
DATABASE_URL=postgresql://admin_abd:<CONTRASEÑA>@localhost:5432/barbershop
SESSION_SECRET=cambie-este-valor-por-una-cadena-larga-aleatoria
# Parametros de negocio (valores por defecto entre parentesis)
PLAZO_MIN_HORAS=2
HORA_APERTURA=08:00
HORA_CIERRE=18:00
